{
  "realm": "security-poc",
  "enabled": true,
  "displayName": "GraphQL Security POC",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {"name": "CUSTOMER"},
      {"name": "SUPPORT"},
      {"name": "ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "poc-frontend",
      "name": "POC Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "graphql-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "graphql-api",
      "name": "GraphQL API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {"id": "11111111-1111-1111-1111-111111111111", "username": "alice", "enabled": true, "email": "alice@example.test", "emailVerified": true, "attributes": {"tenant_id": ["A"]}, "realmRoles": ["CUSTOMER"], "credentials": [{"type": "password", "value": "alice", "temporary": false}]},
    {"id": "22222222-2222-2222-2222-222222222222", "username": "bob", "enabled": true, "email": "bob@example.test", "emailVerified": true, "attributes": {"tenant_id": ["A"]}, "realmRoles": ["CUSTOMER"], "credentials": [{"type": "password", "value": "bob", "temporary": false}]},
    {"id": "33333333-3333-3333-3333-333333333333", "username": "charlie", "enabled": true, "email": "charlie@example.test", "emailVerified": true, "attributes": {"tenant_id": ["B"]}, "realmRoles": ["CUSTOMER"], "credentials": [{"type": "password", "value": "charlie", "temporary": false}]},
    {"id": "44444444-4444-4444-4444-444444444444", "username": "support-a", "enabled": true, "email": "support-a@example.test", "emailVerified": true, "attributes": {"tenant_id": ["A"]}, "realmRoles": ["SUPPORT"], "credentials": [{"type": "password", "value": "support-a", "temporary": false}]},
    {"id": "55555555-5555-5555-5555-555555555555", "username": "admin-a", "enabled": true, "email": "admin-a@example.test", "emailVerified": true, "attributes": {"tenant_id": ["A"]}, "realmRoles": ["ADMIN"], "credentials": [{"type": "password", "value": "admin-a", "temporary": false}]},
    {"id": "66666666-6666-6666-6666-666666666666", "username": "support-b", "enabled": true, "email": "support-b@example.test", "emailVerified": true, "attributes": {"tenant_id": ["B"]}, "realmRoles": ["SUPPORT"], "credentials": [{"type": "password", "value": "support-b", "temporary": false}]},
    {"id": "77777777-7777-7777-7777-777777777777", "username": "admin-b", "enabled": true, "email": "admin-b@example.test", "emailVerified": true, "attributes": {"tenant_id": ["B"]}, "realmRoles": ["ADMIN"], "credentials": [{"type": "password", "value": "admin-b", "temporary": false}]}
  ]
}
